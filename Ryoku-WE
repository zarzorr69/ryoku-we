def _same_generated_index(path: Path, base: Path) -> bool:
    try:
        path.absolute().relative_to(base.absolute())
        return True
    except Exception:
        return False


def hardlink_or_reflink(source: Path, output: Path) -> bool:
    """Expose a large media file without making an ordinary full copy."""
    try:
        os.link(source, output)
        return True
    except FileExistsError:
        return True
    except OSError:
        pass

    # Cross-filesystem fallback for CoW filesystems (btrfs/xfs/reflink-capable).
    cp = command_path("cp") or "/usr/bin/cp"
    result = run([cp, "--reflink=always", "--", source, output], quiet=True, timeout=120)
    return bool(result and result.returncode == 0 and output.is_file())


def safe_index_title(value: str, fallback: str) -> str:
    title = str(value or fallback)
    title = re.sub(r"[^\w .()\-]+", "_", title).strip()
    return (title or fallback)[:90]


def project_media_file(source: Path, data: dict) -> Path | None:
    rel = str(data.get("file") or "").strip()
    if not rel:
        return None
    candidate = source / rel
    if not candidate.is_file():
        return None
    if candidate.suffix.lower() not in {
        ".mp4", ".webm", ".mkv", ".mov", ".m4v",
        ".jpg", ".jpeg", ".png", ".webp", ".gif",
    }:
        return None
    return candidate


def project_preview_file(source: Path, data: dict, *, allow_gif: bool = True) -> Path | None:
    candidates = []
    preview = str(data.get("preview") or "").strip()
    if preview:
        candidates.append(source / preview)

    # Prefer static previews so stable Ryogami does not try to transcode a GIF
    # merely because a Wallpaper Engine scene was selected from the index.
    candidates.extend([
        source / "preview.jpg",
        source / "preview.jpeg",
        source / "preview.png",
        source / "preview.webp",
    ])
    if allow_gif:
        candidates.append(source / "preview.gif")

    seen = set()
    for candidate in candidates:
        key = str(candidate)
        if key in seen:
            continue
        seen.add(key)
        if not candidate.is_file():
            continue
        if not allow_gif and candidate.suffix.lower() == ".gif":
            continue
        if candidate.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp", ".gif"}:
            return candidate
    return None


def make_scene_thumbnail(source: Path, data: dict, output_base: Path) -> Path | None:
    static = project_preview_file(source, data, allow_gif=False)
    if static is not None:
        output = output_base.with_suffix(static.suffix.lower())
        try:
            os.link(static, output)
            return output
        except OSError:
            # Scene previews are small enough to copy when Steam and Pictures
            # live on different filesystems. Never copy full Workshop videos.
            try:
                shutil.copy2(static, output)
                return output
            except OSError:
                pass

    animated = project_preview_file(source, data, allow_gif=True)
    if animated is None:
        return None

    # If only an animated preview exists, extract one still for the picker.
    # The real scene remains in Steam and is rendered by we-layerd.
    output = output_base.with_suffix(".jpg")
    ffmpeg = command_path("ffmpeg")
    if not ffmpeg:
        return None
    result = run([
        ffmpeg, "-loglevel", "error", "-y", "-i", animated,
        "-frames:v", "1", "-q:v", "3", output,
    ], quiet=True, timeout=30)
    return output if result and result.returncode == 0 and output.is_file() else None


def build_workshop_index() -> int:
    root = workshop_root()
    if not root or not root.is_dir():
        say("[warn] Wallpaper Engine Workshop directory not found; index unchanged")
        return 1

    picture_dir = SYNTHETIC_DIR
    video_dir = video_index_dir()
    picture_dir.mkdir(parents=True, exist_ok=True)
    video_dir.mkdir(parents=True, exist_ok=True)

    # Stable Ryogami scans stills/scenes from paths.wallpaper and videos from
    # paths.videoWallpaper. Keep matching "Wallpaper Engine" subfolders in both
    # roots so the picker can present the same logical collection.
    for generated_dir in (picture_dir, video_dir):
        for entry in generated_dir.iterdir():
            if entry.is_file() or entry.is_symlink():
                try:
                    entry.unlink()
                except OSError as exc:
                    say(f"[warn] Could not remove stale index entry {entry.name}: {exc}")

    indexed = 0
    scenes = 0
    videos = 0
    others = 0
    skipped = 0

    for source in sorted(root.iterdir()):
        if not source.is_dir() or not source.name.isdigit():
            continue

        data = read_project(source)
        if not data:
            skipped += 1
            continue

        wid = source.name
        kind = project_type(source)
        title = safe_index_title(data.get("title"), wid)

        if kind == "scene":
            out_base = picture_dir / f"{wid} - {title} [scene]"
            if make_scene_thumbnail(source, data, out_base) is not None:
                indexed += 1
                scenes += 1
            else:
                skipped += 1
            continue

        media = project_media_file(source, data)

        if kind == "video":
            if media is None or media.suffix.lower() not in {".mp4", ".webm", ".mkv", ".mov", ".m4v"}:
                skipped += 1
                say(f"[warn] Workshop {wid} is video but its media file is missing/unsupported")
                continue

            out = video_dir / f"{wid} - {title} [video]{media.suffix.lower()}"
            if hardlink_or_reflink(media, out):
                indexed += 1
                videos += 1
            else:
                say(f"[warn] Could not hardlink/reflink Workshop video {wid}; skipped to avoid duplicating a large file")
                skipped += 1
            continue

        # Non-video/non-scene projects get a picker-safe still entry when possible.
        if media is None or media.suffix.lower() in {".mp4", ".webm", ".mkv", ".mov", ".m4v"}:
            media = project_preview_file(source, data, allow_gif=False)
        if media is None:
            skipped += 1
            continue

        out = picture_dir / f"{wid} - {title} [{kind}]{media.suffix.lower()}"
        try:
            os.link(media, out)
        except FileExistsError:
            pass
        except OSError:
            try:
                shutil.copy2(media, out)
            except OSError as exc:
                say(f"[warn] Could not index Workshop {wid}: {exc}")
                skipped += 1
                continue

        indexed += 1
        others += 1

    say(f"[ok] Wallpaper Engine index: {indexed} entries ({scenes} scene, {videos} video, {others} other, {skipped} skipped)")
    say(f"[ok] Scene/still picker folder: {picture_dir}")
    say(f"[ok] Video picker folder:       {video_dir}")
    return 0


def apply_scene_live_rule(path: Path) -> None:
    if not path.exists():
        return

    s = path.read_text()
    original = s
    desired = (
        'wallpaperLive: wallpaper.live || '
        '(wallpaper.wallpaperPath.indexOf("/Wallpaper Engine/") !== -1 '
        '&& wallpaper.wallpaperPath.indexOf("[scene]") !== -1)'
    )

    patterns = [
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1',
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*\(wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1\s*&&\s*wallpaper\.wallpaperPath\.indexOf\("\[scene\]"\)\s*!==\s*-1\)',
    ]

    replaced = False
    for pat in patterns:
        updated, count = re.subn(pat, desired, s, count=1)
        if count:
            s = updated
            replaced = True
            break

    if not replaced and "wallpaperLive: wallpaper.live" in s:
        s = s.replace("wallpaperLive: wallpaper.live", desired, 1)

    if s != original:
        path.write_text(s)
        say(f"[patched] scene handoff rule: {path}")
    elif desired in s:
        say(f"[ok] scene handoff rule present: {path}")


def selected_path() -> Path | None:
    if not STATE_FILE.is_file():
        return None

    value = STATE_FILE.read_text(errors="replace").strip()

    if value.startswith("file://"):
        value = value[7:]

    return Path(value) if value else None


def selected_workshop(selected: Path | None):
    root = workshop_root()

    if not selected or not root:
        return None, None

    # Native/newer Ryogami can select files directly from the Workshop tree.
    try:
        rel = selected.resolve().relative_to(root.resolve())
        if rel.parts and rel.parts[0].isdigit():
            wid = rel.parts[0]
            source = root / wid
            if source.is_dir():
                return wid, source
    except Exception:
        pass

    # Stable Ryogami uses two roots: pictures for still/scene cards and
    # paths.videoWallpaper for videos. Recover the Workshop ID from either
    # generated index filename because hardlinks do not resolve to Steam paths.
    if not (
        _same_generated_index(selected, SYNTHETIC_DIR)
        or _same_generated_index(selected, video_index_dir())
    ):
        return None, None

    match = re.match(r"^(\d+)\s+-\s+", selected.name)
    if not match:
        return None, None

    wid = match.group(1)
    source = root / wid
    return (wid, source) if source.is_dir() else (None, None)


def read_project(source: Path) -> dict:
    project = source / "project.json"

    if not project.is_file():
        return {}

    try:
        return json.loads(project.read_text(errors="replace"))
    except Exception:
        return {}


def project_type(source: Path) -> str:
    """Return a Wallpaper Engine project type, inferring it when metadata omits `type`."""
    data = read_project(source)
    kind = str(data.get("type", "")).strip().lower()
    if kind:
        return kind

    # Some Workshop uploads omit the `type` field entirely. Infer from the
    # project entry file and common Wallpaper Engine project structure instead
    # of misclassifying them as ordinary still images.
    rel = str(data.get("file", "")).strip()
    suffix = Path(rel).suffix.lower() if rel else ""
    name = Path(rel).name.lower() if rel else ""

    if name == "scene.json" or (source / "scene.json").is_file():
        return "scene"
    if suffix in {".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi"}:
        return "video"
    if suffix in {".html", ".htm"} or (source / "index.html").is_file():
        return "web"

    return "unknown"


def project_title(source: Path) -> str:
    return str(read_project(source).get("title", "")).strip()


def set_we_source(source: Path) -> None:
    if not WE_CONFIG.is_file():
        raise RuntimeError(f"Missing we-layerd config: {WE_CONFIG}")

    lines = WE_CONFIG.read_text().splitlines()
    out = []
    section = ""
    replaced = False

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped

        if section == "[renderer]" and stripped.startswith("source ="):
            out.append(f'source = "{source}"')
            replaced = True
        else:
            out.append(line)

    if not replaced:
        raise RuntimeError(f"renderer.source missing from {WE_CONFIG}")

    WE_CONFIG.write_text("\n".join(out) + "\n")


def kill_native_scene(source: Path) -> None:
    needle = str(source)

    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue

        try:
            cmd = (
                (proc / "cmdline")
                .read_bytes()
                .replace(b"\0", b" ")
                .decode(errors="replace")
            )
        except Exception:
            continue

        if "skwd-wall-vk" not in cmd:
            continue
        if "--scene" not in cmd:
            continue
        if needle not in cmd:
            continue

        try:
            os.kill(int(proc.name), signal.SIGTERM)
        except ProcessLookupError:
            pass


def stop_we() -> None:
    systemctl("stop", "we-layerd.service")


def sync() -> int:
    selected = selected_path()

    if selected is None:
        stop_we()
        return 0

    wid, source = selected_workshop(selected)

    if source is None:
        stop_we()
        say(f"Ryoku native: {selected}")
        return 0

    kind = project_type(source)

    say(f"Workshop: {wid}")
    say(f"Type: {kind or 'unknown'}")

    if kind != "scene":
        stop_we()
        say(f"Ryoku native Workshop renderer: {wid} {kind or 'unknown'}")
        return 0

    set_we_source(source)

    systemctl("restart", "we-layerd.service")
    time.sleep(0.7)

    if not service_active("we-layerd.service"):
        say("[error] we-layerd.service failed; native scene renderer left untouched")
        return 1

    current = selected_path()
    current_id, _ = selected_workshop(current)

    if current_id != wid:
        stop_we()
        return 0

    for _ in range(10):
        current = selected_path()
        current_id, _ = selected_workshop(current)

        if current_id != wid:
            stop_we()
            return 0

        kill_native_scene(source)
        time.sleep(0.10)

    say(f"Wallpaper Engine scene -> we-layerd: {wid}")
    say(f"Source: {source}")
    return 0


