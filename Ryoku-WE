        ("repair", "Install / repair Ryoku-WE support", install),
        ("status", "Detailed status", status),
        ("logo", "Show Ryoku-WE logo", lambda: 0),
        ("uninstall", "Uninstall automation", uninstall),
        ("quit", "Quit", lambda: 0),
    ]

    stdscr.erase()
    h, w = stdscr.getmaxyx()

    if h < 25 or w < 72:
        tui_addstr(stdscr, 1, 2, f"{APP_NAME} needs roughly 72x20 terminal space.", curses.A_BOLD)
        tui_addstr(stdscr, 3, 2, "Resize the terminal, or use CLI commands such as:")
        tui_addstr(stdscr, 5, 4, f"{APP_NAME} status")
        tui_addstr(stdscr, 6, 4, f"{APP_NAME} toggle-mute")
        tui_addstr(stdscr, 7, 4, f"{APP_NAME} repair")
        return menu

    title = f" {APP_NAME} "
    tui_addstr(stdscr, 1, 2, "═" * (w - 4), curses.A_DIM)
    tui_addstr(stdscr, 1, max(3, (w - len(title)) // 2), title, curses.A_BOLD)
    tui_addstr(stdscr, 2, 3, f"Unified Ryoku + Wallpaper Engine support  v{VERSION}", curses.A_DIM)

    audio_text = "MUTED" if muted else "UNMUTED"
    route = info["route"]
    selected = info["project_title"] or Path(info["selected"]).name or info["selected"]

    tui_addstr(stdscr, 4, 4, "Wallpaper audio :", curses.A_BOLD)
    tui_addstr(stdscr, 4, 22, audio_text)

    tui_addstr(stdscr, 5, 4, "Current route   :", curses.A_BOLD)
    tui_addstr(stdscr, 5, 22, route)

    tui_addstr(stdscr, 6, 4, "Selected        :", curses.A_BOLD)
    tui_addstr(stdscr, 6, 22, selected)

    if info["workshop_id"]:
        meta = f"Workshop {info['workshop_id']}  [{info['project_type'] or 'unknown'}]"
        tui_addstr(stdscr, 7, 22, meta, curses.A_DIM)

    we_active = info["units"]["we-layerd.service"][0]
    gif_watch = info["units"]["ryoku-gif-wallpaper-patch.path"][0]
    sync_watch = info["units"]["ryoku-we-sync.path"][0]

    tui_addstr(stdscr, 9, 4, f"we-layerd: {we_active}", curses.A_DIM)
    tui_addstr(stdscr, 9, 26, f"GIF watcher: {gif_watch}", curses.A_DIM)
    tui_addstr(stdscr, 9, 50, f"Router: {sync_watch}", curses.A_DIM)

    tui_addstr(stdscr, 11, 4, "Actions", curses.A_BOLD)

    start_y = 12
    for i, (_, label, _) in enumerate(menu):
        attr = curses.A_REVERSE | curses.A_BOLD if i == selected_index else 0
        prefix = "▶ " if i == selected_index else "  "
        tui_addstr(stdscr, start_y + i, 6, prefix + label, attr)

    footer = "↑/↓ navigate   Enter select   m mute/unmute   s sync   r repair   q quit"
    tui_addstr(stdscr, h - 2, 3, footer, curses.A_DIM)

    return menu





def tui(stdscr) -> int:
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.timeout(1000)

    # Startup logo.
    logo_splash(stdscr, wait_for_key=False)

    index = 0

    while True:
        menu = draw_tui(stdscr, index)
        stdscr.refresh()

        key = stdscr.getch()

        # Timeout is intentional so status information refreshes automatically.
        if key == -1:
            continue

        if key in (ord("q"), ord("Q")):
            return 0

        if key in (curses.KEY_UP, ord("k")):
            index = (index - 1) % len(menu)
            continue

        if key in (curses.KEY_DOWN, ord("j")):
            index = (index + 1) % len(menu)
            continue

        if key in (ord("m"), ord("M")):
            rc, out = capture_action(toggle_audio)
            modal(stdscr, "Audio toggle", out or f"Exit code: {rc}")
            continue

        if key in (ord("s"), ord("S")):
            rc, out = capture_action(sync)
            modal(stdscr, "Sync", out or f"Exit code: {rc}")
            continue

        if key in (ord("r"), ord("R")):
            rc, out = capture_action(install)
            modal(stdscr, "Install / repair", out or f"Exit code: {rc}")
            continue

        if key not in (10, 13):
            continue

        key_name, label, func = menu[index]

        if key_name == "quit":
            return 0

        if key_name == "uninstall":
            if not confirm(stdscr, "Disable and remove Ryoku-WE automation?"):
                continue

        if key_name == "picker":
            # Ryogami opens its own UI; no modal is needed.
            capture_action(open_picker)
            continue

        if key_name == "logo":
            logo_splash(stdscr, wait_for_key=True)
            continue

        rc, out = capture_action(func)
        modal(stdscr, label, out or f"Exit code: {rc}")


def logo_splash(stdscr, *, wait_for_key: bool = False) -> None:
    """
    Render the uploaded 50x22 binary logo using its original grayscale/RGB
    brightness. On 256-color terminals this maps to the xterm 24-step gray ramp.
    """
    stdscr.erase()
    h, w = stdscr.getmaxyx()

    pair_for_shade = {}
    use_256 = False

    try:
        if curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
            except curses.error:
                pass

            # 24 grayscale foreground colors, one pair per xterm gray.
            if getattr(curses, "COLORS", 0) >= 256 and getattr(curses, "COLOR_PAIRS", 0) >= 25:
                use_256 = True
                for shade in range(24):
                    pair = shade + 1
                    curses.init_pair(pair, 232 + shade, -1)
                    pair_for_shade[shade] = curses.color_pair(pair)
    except curses.error:
        use_256 = False

    if h >= LOGO_HEIGHT + 2 and w >= LOGO_WIDTH + 4:
        start_y = max(0, (h - LOGO_HEIGHT) // 2)
        start_x = max(1, (w - LOGO_WIDTH) // 2)

        for row_index, row in enumerate(LOGO_ROWS):
            x = start_x

            for hex_color, text in row:
                lum = _luminance(hex_color)

                if use_256:
                    shade = _xterm_gray_index(hex_color) - 232
                    attr = pair_for_shade.get(shade, 0)
                else:
                    # Graceful fallback for basic-color terminals.
                    if lum < 55:
                        attr = curses.A_DIM
                    elif lum < 150:
                        attr = curses.A_NORMAL
                    else:
                        attr = curses.A_BOLD

                try:
                    stdscr.addstr(start_y + row_index, x, text, attr)
                except curses.error:
                    pass

                x += len(text)

        stdscr.refresh()

        if wait_for_key:
            stdscr.timeout(-1)
            stdscr.getch()
            stdscr.timeout(1000)
        else:
            # Let the exact logo be visible briefly before the main TUI.
            stdscr.timeout(950)
            stdscr.getch()
            stdscr.timeout(1000)
        return

    title = f"{APP_NAME}  v{VERSION}"
    hint = "Enlarge the terminal to display the full 50x22 logo."
    tui_addstr(stdscr, max(1, h // 2 - 1), max(1, (w - len(title)) // 2), title, curses.A_BOLD)
    tui_addstr(stdscr, max(2, h // 2 + 1), max(1, (w - len(hint)) // 2), hint, curses.A_DIM)
    stdscr.refresh()

    if wait_for_key:
        stdscr.timeout(-1)
        stdscr.getch()
        stdscr.timeout(1000)
    else:
        time.sleep(0.6)



def launch_tui() -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        say(f"{APP_NAME}: TUI requires a terminal.")
        say(f"Try: {APP_NAME} status")
        return 1

    try:
        return curses.wrapper(tui)
    except KeyboardInterrupt:
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="TUI + automation for Ryoku GIF/video/Wallpaper Engine support",
    )

    parser.add_argument(
        "command",
        nargs="?",
        default="tui",
        choices=[
            "tui",
            "install",
            "repair",
            "status",
            "sync",
            "index",
            "gif-patch",
            "mute",
            "unmute",
            "toggle-mute",
            "restart-we",
            "picker",
            "logo",
            "uninstall",
        ],
    )

    args = parser.parse_args()

    if args.command == "tui":
        return launch_tui()
    if args.command in ("install", "repair"):
        return install()
    if args.command == "status":
        return status()
    if args.command == "sync":
        return sync()
    if args.command == "index":
        return build_workshop_index()
    if args.command == "gif-patch":
        return gif_patch()
    if args.command == "mute":
        return set_audio_muted(True)
    if args.command == "unmute":
        return set_audio_muted(False)
    if args.command == "toggle-mute":
        return toggle_audio()
    if args.command == "restart-we":
        return restart_we()
    if args.command == "picker":
        return open_picker()
    if args.command == "logo":
        return print_logo()
    if args.command == "uninstall":
        return uninstall()

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
