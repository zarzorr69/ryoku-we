def parse_we_muted() -> bool | None:
    if not WE_CONFIG.exists():
        return None

    section = ""
    try:
        for line in WE_CONFIG.read_text().splitlines():
            stripped = line.strip()

            if stripped.startswith("[") and stripped.endswith("]"):
                section = stripped
                continue

            if section == "[renderer]" and stripped.startswith("muted ="):
                value = stripped.split("=", 1)[1].strip().lower()
                return value in ("true", "1", "yes", "on")
    except Exception:
        pass

    return None


def parse_ryogami_muted() -> bool | None:
    if not RYOKU_CONFIG.exists():
        return None

    try:
        data = json.loads(RYOKU_CONFIG.read_text())
        if "wallpaperMute" in data:
            return bool(data["wallpaperMute"])
    except Exception:
        pass

    return None


def audio_muted(default: bool = True) -> bool:
    we_value = parse_we_muted()
    if we_value is not None:
        return we_value

    ryoku_value = parse_ryogami_muted()
    if ryoku_value is not None:
        return ryoku_value

    return default


def write_we_audio(muted: bool) -> None:
    WE_CONFIG.parent.mkdir(parents=True, exist_ok=True)

    if not WE_CONFIG.exists():
        ensure_we_config(muted=muted)
        return

    lines = WE_CONFIG.read_text().splitlines()
    out = []
    section = ""
    saw_muted = False
    saw_volume = False

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped

        if section == "[renderer]" and stripped.startswith("muted ="):
            out.append(f"muted = {'true' if muted else 'false'}")
            saw_muted = True
            continue

        if section == "[renderer]" and stripped.startswith("volume ="):
            out.append(f"volume = {'0.0' if muted else '1.0'}")
            saw_volume = True
            continue

        out.append(line)

    rebuilt = []
    current = ""
    inserted = False

    for line in out:
        stripped = line.strip()

        if stripped.startswith("[") and stripped.endswith("]"):
            if current == "[renderer]" and not inserted:
                if not saw_volume:
                    rebuilt.append(f"volume = {'0.0' if muted else '1.0'}")
                if not saw_muted:
                    rebuilt.append(f"muted = {'true' if muted else 'false'}")
                inserted = True

            current = stripped

        rebuilt.append(line)

    if current == "[renderer]" and not inserted:
        if not saw_volume:
            rebuilt.append(f"volume = {'0.0' if muted else '1.0'}")
        if not saw_muted:
            rebuilt.append(f"muted = {'true' if muted else 'false'}")

    WE_CONFIG.write_text("\n".join(rebuilt) + "\n")


def write_ryogami_audio(muted: bool) -> None:
    if not RYOKU_CONFIG.exists():
        return

    try:
        data = json.loads(RYOKU_CONFIG.read_text())
    except Exception as exc:
        say(f"[warn] Could not parse {RYOKU_CONFIG}: {exc}")
        return

    data["wallpaperMute"] = bool(muted)
    RYOKU_CONFIG.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def set_audio_muted(muted: bool, *, apply_now: bool = True) -> int:
    write_we_audio(muted)
    write_ryogami_audio(muted)

    say("Wallpaper audio: " + ("MUTED" if muted else "UNMUTED"))

    if not apply_now:
        return 0

    if service_active("we-layerd.service"):
        systemctl("restart", "we-layerd.service")

    if service_active("ryogami.service"):
        systemctl("restart", "ryogami.service")
        time.sleep(0.7)

    sync()
    return 0


def toggle_audio() -> int:
    return set_audio_muted(not audio_muted())


def ensure_ryogami_config(*, muted: bool) -> None:
    if not RYOKU_CONFIG.exists():
        say(f"[warn] Ryogami config not found: {RYOKU_CONFIG}")
        return

    try:
        data = json.loads(RYOKU_CONFIG.read_text())
    except Exception as exc:
        say(f"[warn] Could not parse {RYOKU_CONFIG}: {exc}")
        return

    data.setdefault("features", {})["steam"] = True
    data["wallpaperMute"] = bool(muted)

    RYOKU_CONFIG.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    say(
        "[ok] Ryogami Steam support enabled; wallpaper audio "
        + ("muted" if muted else "unmuted")
    )


