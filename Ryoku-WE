        out.append(line)

    WE_CONFIG.write_text("\n".join(out) + "\n")
    write_we_audio(muted)

    say(
        "[ok] we-layerd configured; wallpaper audio "
        + ("muted" if muted else "unmuted")
    )


def patch_gif_file(path: Path) -> bool:
    if not path.exists():
        say(f"[skip] missing GIF target: {path}")
        return False

    s = path.read_text()
    original = s

    anchor = "    function fillModeFor(img) {"
    helper = (
        "    function isGifSource(s) {\n"
        '        return /\\.gif(?:\\?|$)/i.test(String(s || ""));\n'
        "    }\n\n"
        "    function fillModeFor(img) {"
    )

    if "function isGifSource(s)" not in s:
        if anchor not in s:
            say(f"[warn] GIF patch anchor missing: {path}")
            return False
        s = s.replace(anchor, helper, 1)

    for ident in ("imgA", "imgB"):
        old = "    Image {\n        id: " + ident + "\n"
        new = "    AnimatedImage {\n        id: " + ident + "\n"

        if old in s:
            s = s.replace(old, new, 1)

    for ident in ("imgA", "imgB"):
        pos = s.find("id: " + ident)

        if pos == -1:
            continue

        nearby = s[pos : pos + 500]

        if "playing: view.isGifSource(source)" not in nearby:
            old = (
                "        id: " + ident + "\n"
                "        anchors.fill: parent\n"
                "        cache: false\n"
                "        asynchronous: true\n"
            )

            if old in s:
                s = s.replace(
                    old,
                    old + "        playing: view.isGifSource(source)\n",
                    1,
                )

    s = s.replace(
        "        id: srcA\n"
        "        sourceItem: imgA\n"
        "        hideSource: true\n"
        "        live: false",
        "        id: srcA\n"
        "        sourceItem: imgA\n"
        "        hideSource: true\n"
        "        live: view.isGifSource(imgA.source)",
        1,
    )

    s = s.replace(
        "        id: srcB\n"
        "        sourceItem: imgB\n"
        "        hideSource: true\n"
        "        live: false",
        "        id: srcB\n"
        "        sourceItem: imgB\n"
        "        hideSource: true\n"
        "        live: view.isGifSource(imgB.source)",
        1,
    )

    if s != original:
        path.write_text(s)
        say(f"[patched] GIF support: {path}")
        return True

    say(f"[ok] GIF support already present: {path}")
    return False


def gif_patch() -> int:
    for target in (ACTIVE_BACKDROP, SOURCE_BACKDROP):
        patch_gif_file(target)
    return 0


def restore_native_live_rule(path: Path) -> None:
    if not path.exists():
        return

    s = path.read_text()
    original = s

    patterns = [
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1',
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*\(wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1\s*&&\s*wallpaper\.wallpaperPath\.indexOf\("\[scene\]"\)\s*!==\s*-1\)',
    ]

    for pat in patterns:
        s = re.sub(pat, "wallpaperLive: wallpaper.live", s)

    if s != original:
        path.write_text(s)
        say(f"[restored] native wallpaperLive rule: {path}")


