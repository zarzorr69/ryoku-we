def _logo_plain_lines() -> list[str]:
    return ["".join(text for _color, text in row) for row in LOGO_ROWS]


def _rgb(hex_color: str) -> tuple[int, int, int]:
    return (
        int(hex_color[0:2], 16),
        int(hex_color[2:4], 16),
        int(hex_color[4:6], 16),
    )


def _luminance(hex_color: str) -> float:
    r, g, b = _rgb(hex_color)
    return (0.2126 * r) + (0.7152 * g) + (0.0722 * b)


def _xterm_gray_index(hex_color: str) -> int:
    # xterm grayscale ramp 232..255 corresponds roughly to RGB 8..238.
    lum = _luminance(hex_color)
    shade = round((lum - 8.0) / 10.0)
    return max(0, min(23, shade)) + 232


def print_logo() -> int:
    """
    Print the uploaded logo using its original per-segment RGB values.
    Truecolor terminals get the exact HTML colors; 256-color terminals get
    the closest xterm grayscale shade.
    """
    if not sys.stdout.isatty() or os.environ.get("TERM", "") == "dumb":
        print("\n".join(_logo_plain_lines()))
        return 0

    colorterm = os.environ.get("COLORTERM", "").lower()
    truecolor = "truecolor" in colorterm or "24bit" in colorterm
    reset = "\033[0m"

    for row in LOGO_ROWS:
        rendered = []

        for hex_color, text in row:
            if truecolor:
                r, g, b = _rgb(hex_color)
                rendered.append(f"\033[38;2;{r};{g};{b}m{text}")
            else:
                rendered.append(f"\033[38;5;{_xterm_gray_index(hex_color)}m{text}")

        rendered.append(reset)
        print("".join(rendered))

    return 0



def capture_action(func, *args, **kwargs) -> tuple[int, str]:
    buf = io.StringIO()

    try:
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            rc = func(*args, **kwargs)

        if rc is None:
            rc = 0

        return int(rc), buf.getvalue().strip()
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 1
        if exc.code and not isinstance(exc.code, int):
            print(exc.code, file=buf)
        return code, buf.getvalue().strip()
    except Exception as exc:
        return 1, (buf.getvalue() + f"\n{type(exc).__name__}: {exc}").strip()


def tui_addstr(stdscr, y, x, text, attr=0):
    h, w = stdscr.getmaxyx()

    if y < 0 or y >= h or x >= w:
        return

    max_len = max(0, w - x - 1)

    try:
        stdscr.addnstr(y, x, str(text), max_len, attr)
    except curses.error:
        pass


def modal(stdscr, title: str, body: str) -> None:
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()

        tui_addstr(stdscr, 1, 2, f"{APP_NAME} — {title}", curses.A_BOLD)

        body_lines = []
        width = max(20, w - 6)

        for raw in (body or "(no output)").splitlines():
            wrapped = textwrap.wrap(raw, width=width) or [""]
            body_lines.extend(wrapped)

        max_body = max(1, h - 6)
        shown = body_lines[-max_body:]

        for i, line in enumerate(shown):
            tui_addstr(stdscr, 3 + i, 3, line)

        tui_addstr(stdscr, h - 2, 2, "Press Enter / Esc / q to return", curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()

        if key in (10, 13, 27, ord("q"), ord("Q")):
            return


def confirm(stdscr, prompt: str) -> bool:
    stdscr.erase()
    tui_addstr(stdscr, 2, 2, APP_NAME, curses.A_BOLD)
    tui_addstr(stdscr, 4, 4, prompt)
    tui_addstr(stdscr, 6, 4, "Press y to confirm, anything else to cancel.", curses.A_DIM)
    stdscr.refresh()
    return stdscr.getch() in (ord("y"), ord("Y"))


