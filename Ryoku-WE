muted = {"true" if muted else "false"}
msaa_samples = 1
fill_mode = "cover"
rotation_degrees = 0

[integrations]
media = true
audio_spectrum = false
audio_source = "@DEFAULT_MONITOR@"
audio_sample_rate = 48000
audio_update_hz = 30
"""
        )
        say(f"[created] {WE_CONFIG}")
