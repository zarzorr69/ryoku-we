RestartSec=1
"""
    )

    GIF_SERVICE.write_text(
        f"""[Unit]
Description=Reapply Ryoku GIF wallpaper support

[Service]
Type=oneshot
ExecStart=%h/.local/bin/{APP_NAME} gif-patch

