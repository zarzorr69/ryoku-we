    return 0


def restore_native_live_rule(path: Path) -> None:
    if not path.exists():
        return

    s = path.read_text()
    original = s

    patterns = [
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1',
        r'wallpaperLive:\s*wallpaper\.live\s*\|\|\s*\(wallpaper\.wallpaperPath\.indexOf\("/Wallpaper Engine/"\)\s*!==\s*-1\s*&&\s*wallpaper\.wallpaperPath\.indexOf\("\[scene\]"\)\s*!==\s*-1\)',
    ]

    for pat in patterns:
        s = re.sub(pat, "wallpaperLive: wallpaper.live", s)

    if s != original:
        path.write_text(s)
        say(f"[restored] native wallpaperLive rule: {path}")


