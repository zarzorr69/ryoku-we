        raise SystemExit("we-layerd was not found in PATH or ~/.local/bin.")

    root = steam_root()
    say(f"[ok] Steam root: {root}" if root else "[warn] Steam root not detected")

    current_mute = audio_muted(default=True)

    backup(
        [
            ACTIVE_BACKDROP,
            SOURCE_BACKDROP,
            ACTIVE_SHELL,
            SOURCE_SHELL,
            RYOKU_CONFIG,
            WE_CONFIG,
            GIF_SERVICE,
            GIF_PATH,
            SYNC_SERVICE,
            SYNC_PATH,
            INDEX_SERVICE,
            INDEX_PATH,
            WE_SERVICE,
            *OLD_HELPERS,
