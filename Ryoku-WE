"""
    )

    SYNC_PATH.write_text(
        """[Unit]
Description=Watch Ryoku wallpaper selection for Wallpaper Engine scenes

[Path]
PathChanged=%h/.local/state/ryoku-wallpaper
Unit=ryoku-we-sync.service

[Install]
WantedBy=default.target
"""
    )

    say("[ok] systemd user units written")


def install_self() -> None:
    BIN_DIR.mkdir(parents=True, exist_ok=True)

    current = Path(__file__).resolve()

    if current != INSTALLED_SCRIPT:
        shutil.copy2(current, INSTALLED_SCRIPT)

    INSTALLED_SCRIPT.chmod(0o755)

    alias = BIN_DIR / "ryoku-we"
    try:
        if alias.exists() or alias.is_symlink():
            alias.unlink()
        alias.symlink_to(INSTALLED_SCRIPT.name)
    except OSError:
        pass

    say(f"[installed] {INSTALLED_SCRIPT}")


def install() -> int:
    say(f"{APP_NAME} v{VERSION}")
    say()

    if not command_path("ryoku"):
        raise SystemExit("ryoku was not found in PATH.")
    if not command_path("ryogami"):
        raise SystemExit("ryogami was not found in PATH.")
    if not command_path("we-layerd"):
        raise SystemExit("we-layerd was not found in PATH or ~/.local/bin.")

    root = steam_root()
    say(f"[ok] Steam root: {root}" if root else "[warn] Steam root not detected")

    current_mute = audio_muted(default=True)

    backup(
        [
            ACTIVE_BACKDROP,
            SOURCE_BACKDROP,
            ACTIVE_SHELL,
            SOURCE_SHELL,
            RYOKU_CONFIG,
            WE_CONFIG,
            GIF_SERVICE,
            GIF_PATH,
            SYNC_SERVICE,
            SYNC_PATH,
            WE_SERVICE,
            *OLD_HELPERS,
        ]
    )

    install_self()

    systemctl("disable", "--now", "ryoku-we-sync.path")
    systemctl("disable", "--now", "ryoku-gif-wallpaper-patch.path")

    move_synthetic_folder()
    restore_native_live_rule(ACTIVE_SHELL)
    restore_native_live_rule(SOURCE_SHELL)

    ensure_ryogami_config(muted=current_mute)
    ensure_we_config(muted=current_mute)
    gif_patch()
    write_units()

    systemctl("daemon-reload")
    systemctl("enable", "--now", "ryoku-gif-wallpaper-patch.service")
    systemctl("enable", "--now", "ryoku-gif-wallpaper-patch.path")
    systemctl("enable", "ryoku-we-sync.service")
    systemctl("enable", "--now", "ryoku-we-sync.path")

    if command_path("ryoku"):
        run(["ryoku", "reload"], quiet=True)
        time.sleep(1.5)

    sync()

    say()
    say("Installed.")
    say("  Pictures            -> native Ryoku")
    say("  GIFs                -> native Ryoku AnimatedImage")
    say("  Local videos        -> native Ryoku")
    say("  Workshop videos     -> native Ryoku")
    say("  Workshop scenes     -> we-layerd")
    say("  Wallpaper audio     -> " + ("MUTED" if current_mute else "UNMUTED"))
    say()
    say(f"Launch TUI with: {APP_NAME}")
    return 0


def restart_we() -> int:
    selected = selected_path()
    wid, source = selected_workshop(selected)

    if not source or project_type(source) != "scene":
        say("Current wallpaper is not a Wallpaper Engine scene.")
        return 0

    set_we_source(source)
    systemctl("restart", "we-layerd.service")
    time.sleep(0.7)

    if service_active("we-layerd.service"):
        for _ in range(6):
            kill_native_scene(source)
            time.sleep(0.1)
        say("we-layerd restarted.")
        return 0

    say("[error] we-layerd failed to restart.")
    return 1


def open_picker() -> int:
    result = run(["ryogami", "wallpaper", "ui"], quiet=True)

    if result is None:
        say("[error] Could not launch Ryogami wallpaper picker.")
        return 1

    return result.returncode


def uninstall() -> int:
    say("Disabling Ryoku-WE automation...")

    for unit in (
        "ryoku-we-sync.path",
        "ryoku-we-sync.service",
        "ryoku-gif-wallpaper-patch.path",
        "ryoku-gif-wallpaper-patch.service",
    ):
        systemctl("disable", "--now", unit)

    systemctl("stop", "we-layerd.service")

    for p in (SYNC_PATH, SYNC_SERVICE, GIF_PATH, GIF_SERVICE, WE_SERVICE):
        try:
            p.unlink()
            say(f"[removed] {p}")
        except FileNotFoundError:
            pass

    systemctl("daemon-reload")

    say()
    say("Automation removed.")
    say("The current GIF QML patch and backups were intentionally kept.")
    say(f"Backups: {BACKUP_ROOT}")
    return 0


def status_dict() -> dict:
    selected = selected_path()
    wid, source = selected_workshop(selected)

    info = {
        "selected": str(selected) if selected else "<none>",
        "workshop_id": wid or "",
        "project_type": "",
        "project_title": "",
        "muted": audio_muted(default=True),
        "route": "Native Ryoku",
        "units": {},
        "renderers": [],
        "ryoku_version": "",
    }

    if source:
        info["project_type"] = project_type(source)
        info["project_title"] = project_title(source)

        if info["project_type"] == "scene":
            info["route"] = "we-layerd" if service_active("we-layerd.service") else "scene pending/native"
        else:
            info["route"] = "Native Ryoku"

    if command_path("ryoku"):
        r = run(["ryoku", "--version"], capture=True)
        if r and r.stdout:
            info["ryoku_version"] = r.stdout.strip()

    for unit in (
        "ryoku-gif-wallpaper-patch.path",
        "ryoku-we-sync.path",
        "we-layerd.service",
        "ryogami.service",
        "ryoku-shell.service",
    ):
        info["units"][unit] = unit_state(unit)

    proc = run(
        ["pgrep", "-a", "-f", "skwd-wall-vk|skwd-paper-v2|we-layerd"],
        capture=True,
    )

    if proc and proc.returncode == 0 and proc.stdout:
        info["renderers"] = [line for line in proc.stdout.splitlines() if line.strip()]

    return info


def status() -> int:
    info = status_dict()

    say(f"{APP_NAME} v{VERSION}")

    if info["ryoku_version"]:
        say(f"Ryoku: {info['ryoku_version']}")

    say(f"Wallpaper audio: {'MUTED' if info['muted'] else 'UNMUTED'}")
    say(f"Selected: {info['selected']}")

    if info["workshop_id"]:
        say(f"Workshop ID: {info['workshop_id']}")
        say(f"Title: {info['project_title'] or '<unknown>'}")
        say(f"Project type: {info['project_type'] or 'unknown'}")

    say(f"Route: {info['route']}")
    say()

    for unit, (active, enabled) in info["units"].items():
        say(f"{unit}: active={active}, enabled={enabled}")

    say()

    if WE_CONFIG.exists():
        section = ""
        for line in WE_CONFIG.read_text().splitlines():
            stripped = line.strip()

            if stripped.startswith("[") and stripped.endswith("]"):
                section = stripped

            if section == "[renderer]" and stripped.startswith(("source =", "volume =", "muted =")):
                say("we-layerd " + stripped)

    say()

    if info["renderers"]:
        say("Renderers:")
        for line in info["renderers"]:
            say(line)
    else:
        say("Renderers: none")

    return 0


def capture_action(func, *args, **kwargs) -> tuple[int, str]:
    buf = io.StringIO()

    try:
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
            rc = func(*args, **kwargs)

        if rc is None:
            rc = 0

        return int(rc), buf.getvalue().strip()
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 1
        if exc.code and not isinstance(exc.code, int):
            print(exc.code, file=buf)
        return code, buf.getvalue().strip()
    except Exception as exc:
        return 1, (buf.getvalue() + f"\n{type(exc).__name__}: {exc}").strip()


def tui_addstr(stdscr, y, x, text, attr=0):
    h, w = stdscr.getmaxyx()

    if y < 0 or y >= h or x >= w:
        return

    max_len = max(0, w - x - 1)

    try:
        stdscr.addnstr(y, x, str(text), max_len, attr)
    except curses.error:
        pass


def modal(stdscr, title: str, body: str) -> None:
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()

        tui_addstr(stdscr, 1, 2, f"{APP_NAME} — {title}", curses.A_BOLD)

        body_lines = []
        width = max(20, w - 6)

        for raw in (body or "(no output)").splitlines():
            wrapped = textwrap.wrap(raw, width=width) or [""]
            body_lines.extend(wrapped)

        max_body = max(1, h - 6)
        shown = body_lines[-max_body:]

        for i, line in enumerate(shown):
            tui_addstr(stdscr, 3 + i, 3, line)

        tui_addstr(stdscr, h - 2, 2, "Press Enter / Esc / q to return", curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()

        if key in (10, 13, 27, ord("q"), ord("Q")):
            return


def confirm(stdscr, prompt: str) -> bool:
    stdscr.erase()
    tui_addstr(stdscr, 2, 2, APP_NAME, curses.A_BOLD)
    tui_addstr(stdscr, 4, 4, prompt)
    tui_addstr(stdscr, 6, 4, "Press y to confirm, anything else to cancel.", curses.A_DIM)
    stdscr.refresh()
    return stdscr.getch() in (ord("y"), ord("Y"))


def draw_tui(stdscr, selected_index: int):
    info = status_dict()
    muted = info["muted"]

    menu = [
        ("picker", "Open Ryoku wallpaper picker", open_picker),
        ("mute", "Unmute wallpaper audio" if muted else "Mute wallpaper audio", toggle_audio),
        ("sync", "Sync current wallpaper / renderer", sync),
        ("gif", "Reapply GIF support", gif_patch),
        ("we", "Restart Wallpaper Engine renderer", restart_we),
        ("repair", "Install / repair Ryoku-WE support", install),
        ("status", "Detailed status", status),
        ("logo", "Show Ryoku-WE logo", print_logo),
        ("uninstall", "Uninstall automation", uninstall),
        ("quit", "Quit", lambda: 0),
    ]

    stdscr.erase()
    h, w = stdscr.getmaxyx()

    if h < 20 or w < 72:
        tui_addstr(stdscr, 1, 2, f"{APP_NAME} needs roughly 72x20 terminal space.", curses.A_BOLD)
        tui_addstr(stdscr, 3, 2, "Resize the terminal, or use CLI commands such as:")
        tui_addstr(stdscr, 5, 4, f"{APP_NAME} status")
        tui_addstr(stdscr, 6, 4, f"{APP_NAME} toggle-mute")
        tui_addstr(stdscr, 7, 4, f"{APP_NAME} repair")
        return menu

    title = f" {APP_NAME} "
    tui_addstr(stdscr, 1, 2, "═" * (w - 4), curses.A_DIM)
    tui_addstr(stdscr, 1, max(3, (w - len(title)) // 2), title, curses.A_BOLD)
    tui_addstr(stdscr, 2, 3, f"Unified Ryoku + Wallpaper Engine support  v{VERSION}", curses.A_DIM)

    audio_text = "MUTED" if muted else "UNMUTED"
    route = info["route"]
    selected = info["project_title"] or Path(info["selected"]).name or info["selected"]

    tui_addstr(stdscr, 4, 4, "Wallpaper audio :", curses.A_BOLD)
    tui_addstr(stdscr, 4, 22, audio_text)

    tui_addstr(stdscr, 5, 4, "Current route   :", curses.A_BOLD)
    tui_addstr(stdscr, 5, 22, route)

    tui_addstr(stdscr, 6, 4, "Selected        :", curses.A_BOLD)
    tui_addstr(stdscr, 6, 22, selected)

    if info["workshop_id"]:
        meta = f"Workshop {info['workshop_id']}  [{info['project_type'] or 'unknown'}]"
        tui_addstr(stdscr, 7, 22, meta, curses.A_DIM)

    we_active = info["units"]["we-layerd.service"][0]
    gif_watch = info["units"]["ryoku-gif-wallpaper-patch.path"][0]
    sync_watch = info["units"]["ryoku-we-sync.path"][0]

    tui_addstr(stdscr, 9, 4, f"we-layerd: {we_active}", curses.A_DIM)
    tui_addstr(stdscr, 9, 26, f"GIF watcher: {gif_watch}", curses.A_DIM)
    tui_addstr(stdscr, 9, 50, f"Router: {sync_watch}", curses.A_DIM)

    tui_addstr(stdscr, 11, 4, "Actions", curses.A_BOLD)

    start_y = 12
    for i, (_, label, _) in enumerate(menu):
        attr = curses.A_REVERSE | curses.A_BOLD if i == selected_index else 0
        prefix = "▶ " if i == selected_index else "  "
        tui_addstr(stdscr, start_y + i, 6, prefix + label, attr)

    footer = "↑/↓ navigate   Enter select   m mute/unmute   s sync   r repair   q quit"
    tui_addstr(stdscr, h - 2, 3, footer, curses.A_DIM)

    return menu



def logo_splash(stdscr) -> None:
    """Show the full binary Ryoku-WE logo when the terminal is large enough."""
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    lines = LOGO.splitlines()

    # The logo is 60 columns by 27 lines. Preserve it exactly; never scale it.
    if h >= len(lines) + 5 and w >= 64:
        start_y = max(1, (h - len(lines) - 2) // 2)
        start_x = max(1, (w - 60) // 2)

        for i, line in enumerate(lines):
            tui_addstr(stdscr, start_y + i, start_x, line, curses.A_BOLD)

        title = f"{APP_NAME}  v{VERSION}"
        tui_addstr(
            stdscr,
            start_y + len(lines) + 1,
            max(1, (w - len(title)) // 2),
            title,
            curses.A_BOLD,
        )
        stdscr.refresh()

        # Brief splash. Any key skips immediately.
        stdscr.timeout(900)
        stdscr.getch()
        stdscr.timeout(1000)
    else:
        # Small terminals keep the main TUI usable. The exact logo remains
        # available with `Ryoku-WE logo`.
        title = f"{APP_NAME}  v{VERSION}"
        tui_addstr(stdscr, max(1, h // 2 - 1), max(1, (w - len(title)) // 2), title, curses.A_BOLD)
        tui_addstr(stdscr, max(2, h // 2 + 1), 2, "Tip: run `Ryoku-WE logo` to print the full binary logo.", curses.A_DIM)
        stdscr.refresh()
        stdscr.timeout(650)
        stdscr.getch()
        stdscr.timeout(1000)



def tui(stdscr) -> int:
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.timeout(1000)

    logo_splash(stdscr)

    index = 0

    while True:
        menu = draw_tui(stdscr, index)
        stdscr.refresh()

        key = stdscr.getch()

        if key == -1:
            continue
        if key in (ord("q"), ord("Q")):
            return 0
        if key in (curses.KEY_UP, ord("k")):
            index = (index - 1) % len(menu)
            continue
        if key in (curses.KEY_DOWN, ord("j")):
            index = (index + 1) % len(menu)
            continue

        if key in (ord("m"), ord("M")):
            rc, out = capture_action(toggle_audio)
            modal(stdscr, "Audio toggle", out or f"Exit code: {rc}")
            continue

        if key in (ord("s"), ord("S")):
            rc, out = capture_action(sync)
            modal(stdscr, "Sync", out or f"Exit code: {rc}")
            continue

        if key in (ord("r"), ord("R")):
            rc, out = capture_action(install)
            modal(stdscr, "Install / repair", out or f"Exit code: {rc}")
            continue

        if key not in (10, 13):
            continue

        key_name, label, func = menu[index]

        if key_name == "quit":
            return 0

        if key_name == "uninstall" and not confirm(
            stdscr, "Disable and remove Ryoku-WE automation?"
        ):
            continue

        if key_name == "picker":
            capture_action(open_picker)
            continue

        if key_name == "logo":
            splash(stdscr)
            continue

        rc, out = capture_action(func)
        modal(stdscr, label, out or f"Exit code: {rc}")



def splash(stdscr) -> None:
    """Show the Ryoku-WE binary logo when the terminal is large enough."""
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    lines = LOGO.splitlines()

    # Full logo is 60 columns x 27 rows. Show it only when it fits comfortably.
    if h >= len(lines) + 8 and w >= 68:
        start_y = max(1, (h - len(lines) - 4) // 2)
        for i, line in enumerate(lines):
            x = max(0, (w - len(line)) // 2)
            tui_addstr(stdscr, start_y + i, x, line, curses.A_DIM)

        title = f"{APP_NAME}  v{VERSION}"
        tui_addstr(stdscr, start_y + len(lines) + 1, max(0, (w - len(title)) // 2), title, curses.A_BOLD)
        hint = "Ryoku + GIF + Wallpaper Engine"
        tui_addstr(stdscr, start_y + len(lines) + 2, max(0, (w - len(hint)) // 2), hint, curses.A_DIM)
        stdscr.refresh()
        time.sleep(0.8)
    else:
        title = f"{APP_NAME}  v{VERSION}"
        tui_addstr(stdscr, max(1, h // 2 - 1), max(0, (w - len(title)) // 2), title, curses.A_BOLD)
        hint = "Ryoku + GIF + Wallpaper Engine"
        tui_addstr(stdscr, max(2, h // 2 + 1), max(0, (w - len(hint)) // 2), hint, curses.A_DIM)
        stdscr.refresh()
        time.sleep(0.5)

def launch_tui() -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        say(f"{APP_NAME}: TUI requires a terminal.")
        say(f"Try: {APP_NAME} status")
        return 1

    try:
        def _run(stdscr):
            curses.curs_set(0)
            splash(stdscr)
            return tui(stdscr)
        return curses.wrapper(_run)
    except KeyboardInterrupt:
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="TUI + automation for Ryoku GIF/video/Wallpaper Engine support",
    )

    parser.add_argument(
        "command",
        nargs="?",
        default="tui",
        choices=[
            "tui",
            "install",
            "repair",
            "status",
            "sync",
            "gif-patch",
            "mute",
            "unmute",
            "toggle-mute",
            "restart-we",
            "picker",
            "logo",
            "uninstall",
        ],
    )

    args = parser.parse_args()

    if args.command == "tui":
        return launch_tui()
    if args.command in ("install", "repair"):
        return install()
    if args.command == "status":
        return status()
    if args.command == "sync":
        return sync()
    if args.command == "gif-patch":
        return gif_patch()
    if args.command == "mute":
        return set_audio_muted(True)
    if args.command == "unmute":
        return set_audio_muted(False)
    if args.command == "toggle-mute":
        return toggle_audio()
    if args.command == "restart-we":
        return restart_we()
    if args.command == "picker":
        return open_picker()
    if args.command == "logo":
        return print_logo()
    if args.command == "uninstall":
        return uninstall()

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
