    assets = we_assets_root()
    assets_text = str(assets) if assets else ""

    WE_CONFIG.parent.mkdir(parents=True, exist_ok=True)

    if not WE_CONFIG.exists():
        WE_CONFIG.write_text(
            f"""[general]
interactive = false
show_fps = false
scale_mode = "cover"

[renderer]
library_path = ""
source = ""
assets_path = "{assets_text}"
cache_path = "~/.cache/we-layerd/renderer"
