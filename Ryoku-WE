        return

    dest_root = HOME / ".local/share/ryoku-backups"
    dest_root.mkdir(parents=True, exist_ok=True)
    dest = dest_root / f"Wallpaper Engine.synthetic-old-{timestamp()}"

    shutil.move(str(SYNTHETIC_DIR), str(dest))
